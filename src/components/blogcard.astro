---
import { Image } from "astro:assets";
import Label from "@/components/ui/label.astro";
import { categories } from "@/data/category";
import { authors } from "@/data/authors";
import { getFormattedDate } from "@/utils/all";

const { post, aspect, preloadImage } = Astro.props;

const category = categories.find(
  (item) => item.slug === post.data.category
);
const author = authors.find((item) => item.slug === post.data.author);
---

<div class="group cursor-pointer">
  <div class="overflow-hidden rounded-md bg-gray-100 transition-all hover:scale-105 dark:bg-gray-800 aspect-video">
    <a class="relative block aspect-video" href={`/blog/${post.slug}`}>
      {
        post.data.image ? (
          <Image
            src={post.data.image}
            alt={post.data.title || "Thumbnail"}
            width={800}
            height={600}
            loading={preloadImage ? "eager" : "lazy"}
            class="h-full w-full object-cover transition-all"
          />
        ) : (
          <div class="flex h-full w-full items-center justify-center text-gray-400">No image</div>
        )
      }
    </a>
  </div>

  <div class="mt-4">
    {
      category && (
        <a href={`/category/${category.slug}`}>
          <Label theme={category.color}>{category.title}</Label>
        </a>
      )
    }
    <h2 class="mt-2 text-lg font-semibold tracking-normal text-brand-primary dark:text-white">
      <a href={`/blog/${post.slug}`}>
        <span class="bg-gradient-to-r from-green-200 to-green-100 bg-[length:0px_10px] bg-left-bottom bg-no-repeat transition-[background-size] duration-500 hover:bg-[length:100%_3px] group-hover:bg-[length:100%_10px] dark:from-purple-800 dark:to-purple-900">
          {post.data.title}
        </span>
      </a>
    </h2>

    <div class="mt-3 flex items-center space-x-3 text-gray-500 dark:text-gray-400">
      <div class="flex items-center gap-3">
        <div class="relative h-5 w-5 flex-shrink-0">
          {
            author?.image && (
              <Image
                src={author.image}
                alt={author.name}
                width={40}
                height={40}
                class="rounded-full object-cover"
              />
            )
          }
        </div>
        <span class="truncate text-sm">
          {author?.name || "Tác giả"}
        </span>
      </div>
      <span class="text-xs text-gray-300 dark:text-gray-600">•</span>
      <time class="text-sm" datetime={post.data.publishDate}>
        {getFormattedDate(post.data.publishDate)}
      </time>
    </div>
  </div>
</div>