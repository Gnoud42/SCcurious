---
import Layout from "../layouts/Layout.astro";

const categories = [
  { name: "Độ Xe", slug: "do-xe", icon: "🔧", image: "/images/do-xe-cover.jpg" },
  { name: "Video", slug: "video", icon: "🎬", image: "/images/video-cover.jpg" },
  { name: "Phụ Kiện 1/18", slug: "phu-kien-118", icon: "🛠️", image: "/images/phu-kien-118-cover.jpg" },
  { name: "Ảnh Xe Đẹp Từ Thành Viên", slug: "anh-thanh-vien", icon: "📸", image: "/images/anh-thanh-vien-cover.jpg" },
  { name: "Review Xe", slug: "review", icon: "📝", image: "/images/review-cover.jpg" },
  { name: "Chia Sẻ Kinh Nghiệm", slug: "chia-se-kinh-nghiem", icon: "💡", image: "/images/chia-se-kinh-nghiem-cover.jpg" },
];
---
<Layout title="Trang chủ">
  <section style="padding: 3rem 1rem;">
    <div style="max-width: 1100px; margin: 0 auto;">
      <!-- <h1 style="text-align: center; margin-bottom: 2rem;">SCcurious</h1> -->
      <h1 style="text-align: center; margin-bottom: 2rem; font-size: 3rem; font-family: 'Georgia', serif; font-style: italic; font-weight: 3000;">
        SCcurious
      </h1>
      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem;">
        {categories.map((cat) => (
          <a href={`/${cat.slug}`} style="position: relative; display: block; height: 260px; border-radius: 14px; overflow: hidden; text-decoration: none;">
            <img src={cat.image} alt={cat.name} style="width: 100%; height: 100%; object-fit: cover;" />
            <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.75), rgba(0,0,0,0.1)); display: flex; align-items: flex-end; padding: 1.2rem;">
              <h2 style="color: white; font-size: 1.3rem; margin: 0;">{cat.icon} {cat.name}</h2>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>